[Unit]
Description=IleraPoint local vitals sensor bridge
After=network.target

[Service]
Type=simple
User=__ILERA_USER__
WorkingDirectory=__ILERA_ROOT__
Environment=PYTHONUNBUFFERED=1
Environment=VITALS_PULSE_CAPTURE_SECONDS=10
Environment=VITALS_PULSE_MAX_ATTEMPTS=2
Environment=VITALS_FINGER_WAIT_SECONDS=6
Environment=VITALS_TEMPERATURE_POSITION_SECONDS=3
Environment=VITALS_TEMPERATURE_SAMPLE_COUNT=6
Environment=VITALS_RAW_LOG_DIR=/var/lib/ilerapoint-vitals/captures
Environment=VITALS_RAW_LOG_LIMIT=20
StateDirectory=ilerapoint-vitals
ExecStart=__ILERA_ROOT__/.venv/bin/python -m vitals_bridge.app
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
