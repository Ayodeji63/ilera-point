SAHARA_API_KEY=
# Sahara allows 3 /tts/v1/stream connections per minute; over that it answers
# with an HTTP 429 on the upgraded socket. Background preloads use the queue API;
# an interactive stream failure switches immediately to /tts/v1/generate.
SAHARA_STREAM_LIMIT_PER_MINUTE=3
GEMINI_API_KEY=
# Optional comma-separated failover pool. The legacy key above is included too.
# Use independently provisioned projects; keys from one project share its quota.
GEMINI_API_KEYS=
GEMINI_PRESCRIPTION_MODEL=gemini-2.5-flash-lite
# Optional, used only by scripts/benchmark-asr.js for comparison runs.
GEMINI_ASR_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_ASR_MODEL=gpt-4o-transcribe
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_VISION_MODEL=gemini-2.5-flash-lite
GEMINI_SCRIPT_MODEL=gemini-2.5-flash
PORT=8787
# Localhost-only Python sensor bridge on the Raspberry Pi.
VITALS_BRIDGE_URL=http://127.0.0.1:8765
# Pi-side calibration controls. Pulse is measured first; temperature starts
# only after the pulse attempt finishes.
VITALS_PULSE_CAPTURE_SECONDS=10
VITALS_PULSE_MAX_ATTEMPTS=2
VITALS_FINGER_WAIT_SECONDS=6
VITALS_TEMPERATURE_POSITION_SECONDS=3
VITALS_TEMPERATURE_SAMPLE_COUNT=6
VITALS_AMBIENT_MIN_C=18
VITALS_AMBIENT_MAX_C=32
# Ambient bounds lower confidence only; they do not reject a stable forehead
# surface burst as missing skin.
# Leave these unset until fitted from paired reference-device measurements.
# VITALS_TEMPERATURE_CALIBRATION_A=
# VITALS_TEMPERATURE_CALIBRATION_B=
# VITALS_SPO2_CALIBRATION_A=
# VITALS_SPO2_CALIBRATION_B=
# Optional override. The browser defaults to this Pi-local address even when
# the Vercel variable is missing. This is a public location, not a secret.
VITE_VITALS_API_ORIGIN=http://127.0.0.1:8787
# How long a hashed active-result token and return code remain usable. Seven
# days lets patients return after a delayed clinician review; confirm locally.
PATIENT_RESULT_ACCESS_HOURS=168
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_VIDEO_BUCKET=consultation-videos
SUPABASE_ALERT_BUCKET=escalation-alerts
# Red-flag voice escalation. Without these the alert is skipped and logged; the
# consultation still saves and still routes to a doctor.
ESCALATION_PHONE_NUMBER=
ESCALATION_MAX_ATTEMPTS=3
ESCALATION_RETRY_BACKOFF_SECONDS=15
# Africa's Talking Voice. Use sandbox while testing and live only after the
# callback URLs and purchased voice number have been verified.
AT_ENVIRONMENT=sandbox
AT_USERNAME=
AT_API_KEY=
AT_PHONE_NUMBER=
# Per-process hostile-input protection for the public provider callbacks.
TELEPHONY_CALLBACK_RATE_LIMIT=120
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Vercel cannot proxy WebSocket upgrades through its HTTP API rewrite. Set this
# to the public Render API origin so live transcription connects there directly.
VITE_SPEECH_WS_ORIGIN=wss://ilera-point.onrender.com

# Privacy and retention. Confirm the clinical period with the deploying clinic
# and its data-protection/records lead before enabling destructive cleanup.
PATIENT_LOOKUP_RATE_LIMIT=10
PATIENT_RESULT_LOOKUP_RATE_LIMIT=10
RETENTION_VIDEO_DAYS=30
RETENTION_AUDIT_DAYS=365
RETENTION_BENCHMARK_DAYS=365
RETENTION_CLINICAL_DAYS=2190
RETENTION_DELETE_CLINICAL_RECORDS=0
# Comma-separated voice languages to disable when local validation fails.
DISABLED_LANGUAGE_CODES=
