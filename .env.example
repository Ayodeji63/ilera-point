SAHARA_API_KEY=
SAHARA_TTS_POOL_SIZE=1
# Sahara allows 3 /tts/v1/stream connections per minute; over that it answers
# with an HTTP 429 on the upgraded socket. Speech falls back to /tts/v1/generate.
SAHARA_STREAM_LIMIT_PER_MINUTE=3
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_VISION_MODEL=gemini-2.5-flash-lite
GEMINI_SCRIPT_MODEL=gemini-2.5-flash
PORT=8787
# Tencent Cloud Face Recognition (IAI). This is a different product from PalmAI:
# it uses a Tencent Cloud SecretId/SecretKey pair, not a bearer API key.
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_FACE_REGION=ap-singapore
TENCENT_FACE_GROUP_ID=ilerapoint-patients
# A face is accepted only above this score AND only when the runner-up is at
# least FACE_MATCH_MARGIN behind. Calibrate against real faces before trusting.
FACE_MATCH_THRESHOLD=80
FACE_MATCH_MARGIN=5
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_VIDEO_BUCKET=consultation-videos
SUPABASE_ALERT_BUCKET=escalation-alerts
# Red-flag voice escalation. Without these the alert is skipped and logged; the
# consultation still saves and still routes to a doctor.
ESCALATION_PHONE_NUMBER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
