SAHARA_API_KEY=
SAHARA_TTS_POOL_SIZE=1
# Sahara allows 3 /tts/v1/stream connections per minute; over that it answers
# with an HTTP 429 on the upgraded socket. Speech falls back to /tts/v1/generate.
SAHARA_STREAM_LIMIT_PER_MINUTE=3
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_VISION_MODEL=gemini-2.5-flash-lite
GEMINI_SCRIPT_MODEL=gemini-2.5-flash
PORT=8787
# Localhost-only Python sensor bridge on the Raspberry Pi.
VITALS_BRIDGE_URL=http://127.0.0.1:8765
# Pi-side calibration controls. Pulse is measured first; temperature starts
# only after the pulse attempt finishes.
VITALS_PULSE_CAPTURE_SECONDS=10
VITALS_PULSE_MAX_ATTEMPTS=2
VITALS_FINGER_WAIT_SECONDS=6
VITALS_TEMPERATURE_POSITION_SECONDS=3
VITALS_TEMPERATURE_SAMPLE_COUNT=6
# Optional override. The browser defaults to this Pi-local address even when
# the Vercel variable is missing. This is a public location, not a secret.
VITE_VITALS_API_ORIGIN=http://127.0.0.1:8787
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_VIDEO_BUCKET=consultation-videos
SUPABASE_ALERT_BUCKET=escalation-alerts
# Red-flag voice escalation. Without these the alert is skipped and logged; the
# consultation still saves and still routes to a doctor.
ESCALATION_PHONE_NUMBER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Vercel cannot proxy WebSocket upgrades through its HTTP API rewrite. Set this
# to the public Render API origin so live transcription connects there directly.
VITE_SPEECH_WS_ORIGIN=wss://ilera-point.onrender.com
