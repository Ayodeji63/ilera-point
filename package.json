{
  "name": "ilera-point",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite\" \"node --watch server/index.js\"",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/index.js",
    "test": "vitest run",
    "benchmark:hausa": "node scripts/benchmark-hausa.mjs",
    "benchmark:asr": "node scripts/benchmark-asr.js",
    "benchmark:codeswitch:audit": "python3 audit_refs.py --manifest manifest.csv --hyp hyps/sahara.csv",
    "benchmark:codeswitch": "python3 codeswitch_eval.py --manifest manifest.csv --hyp sahara=hyps/sahara.csv --hyp gemini=hyps/gemini.csv --outdir benchmarks/results/codeswitch-baseline",
    "benchmark:codeswitch:include-unverified": "python3 codeswitch_eval.py --manifest manifest.csv --hyp sahara=hyps/sahara.csv --hyp gemini=hyps/gemini.csv --hyp unverified_whisper_riva=hyps/whisper_riva.csv --outdir benchmarks/results/codeswitch-with-unverified",
    "privacy:retention": "node scripts/cleanup-retention.mjs"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@supabase/supabase-js": "^2.113.0",
    "@vitejs/plugin-react": "latest",
    "cors": "latest",
    "dotenv": "latest",
    "express": "latest",
    "lucide-react": "latest",
    "multer": "latest",
    "react": "latest",
    "react-dom": "latest",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "autoprefixer": "latest",
    "concurrently": "latest",
    "postcss": "latest",
    "puppeteer-core": "^25.9.0",
    "tailwindcss": "3.4.17",
    "vite": "latest",
    "vitest": "latest"
  }
}
